# 공공데이터포털(data.go.kr) API 설정
# 키를 넣지 않은 견본 파일. 복사해서 .env로 이름을 바꾼 뒤 키를 붙여 넣기
# 키는 활용신청 후 마이페이지의 "일반 인증키(Decoding)"를 붙여 넣기

# 한국천문연구원_특일 정보 (공휴일·기념일)
KASI_SPCDE_API_KEY=
KASI_SPCDE_ENDPOINT=https://apis.data.go.kr/B090041/openapi/service/SpcdeInfoService

# 한국관광공사_국문 관광정보 서비스 — 대구 지역만 필터링해서 사용
KTO_TOUR_API_KEY=
KTO_TOUR_ENDPOINT=https://apis.data.go.kr/B551011/KorService2
# 대구 필터: 법정동 시도코드(lDongRegnCd) 27 = 대구광역시
KTO_TOUR_LDONG_REGN_CD=27

# 기상청_지상(종관, ASOS) 일자료 조회서비스
KMA_ASOS_API_KEY=
KMA_ASOS_ENDPOINT=https://apis.data.go.kr/1360000/AsosDalyInfoService
# 지점번호(stnIds) 143 = 대구
KMA_ASOS_STN_ID=143

# KAMIS 농산물 도·소매가 (aT 농산물유통정보, kamis.or.kr → 고객센터 → Open API)
# 예비용: 아래 AT_PERDAY(일별 도·소매 가격정보)가 같은 KAMIS 데이터를 주므로 기본은 perDay 사용
# KAMIS는 키 2개가 필요: 인증키(p_cert_key) + 신청한 아이디(p_cert_id)
KAMIS_CERT_KEY=
KAMIS_CERT_ID=
KAMIS_ENDPOINT=https://www.kamis.or.kr/service/price/xml.do
# 대구 지역코드(p_countrycode) 2200
KAMIS_COUNTRY_CODE=2200

# 한국농수산식품유통공사_전국 공영도매시장 정산정보 — 경락가 (data.go.kr/data/15141809)
AT_SALE_API_KEY=
AT_SALE_ENDPOINT=https://apis.data.go.kr/B552845/katSale
# 일별 정산 조회는 주소 뒤에 /trades 를 붙여 호출
# 도매시장 코드(whsl_mrkt_cd) 220001 = 대구 북부도매시장(매천시장, 북구)
AT_WHSL_MRKT_CD=220001

# 한국농수산식품유통공사_일별 도·소매 가격정보 조회
AT_PERDAY_API_KEY=
AT_PERDAY_ENDPOINT=https://apis.data.go.kr/B552845/perDay
# 조회는 주소 뒤에 /price 를 붙여 호출. 필수 조건: 조사일자 cond[exmn_ymd::GTE/LTE](YYYYMMDD), 부류 cond[ctgry_cd::EQ], 품목 cond[item_cd::EQ]
# 품목 코드는 KAMIS와 같음 (예: 채소 200 / 양파 245). 약 2일 늦게 등록됨
# 지역 cond[sgg_cd::EQ] 2200 = 대구 (중도매: 북부도매 · 소매: 칠성 등)
AT_PERDAY_SGG_CD=2200

# 한국농수산식품유통공사_전국 공영도매시장 실시간 경매정보 (data.go.kr/data/15141808)
AT_REALTIME_API_KEY=
AT_REALTIME_ENDPOINT=https://apis.data.go.kr/B552845/katRealTime2
# 경매 내역 조회는 주소 뒤에 /trades2 를 붙여 호출, 시장 코드는 위 AT_WHSL_MRKT_CD(220001) 사용

# 구글 제미나이 (살피 AI 에이전트) — aistudio.google.com → Get API key 에서 무료 발급
GEMINI_API_KEY=
# 쓸 모델 이름. 모델이 없어지면 여기만 바꾸면 됨 (2026-11-03 기준 무료로 확인)
GEMINI_MODEL=gemini-3.5-flash
# 기본 모델이 바쁘거나 무료 한도를 넘으면 아래 순서대로 자동으로 갈아탐
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-flash-latest,gemini-3.5-flash-lite
